  "article": {
    "title": "Mr. Maw",
    "url": "https://bindingofisaacrebirth.wiki.gg/wiki/Mr._Maw",
    "revision_url": "https://bindingofisaacrebirth.wiki.gg/index.php?oldid=269831",
    "revision": 269831,
    "timestamp": "2026-09-30T10:20:42Z",
