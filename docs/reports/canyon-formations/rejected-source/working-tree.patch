+// Finite geological footprints, independent of the room perimeter. Their
+// overlapping superlevel sets create local raised formations, not inset bands.
+float formationPatch(float x, float z, uint64_t seed, int layer, const CanyonVisualParameters &p) {
+    constexpr float span = 15;
+    int ix = int(std::floor(x / span)), iz = int(std::floor(z / span));
+    float result = -100;
+    uint64_t salt = seed ^ (0x50415443484d4553ULL + uint64_t(layer) * 0x9e3779b97f4a7c15ULL);
+    float scale = std::sqrt(p.terraceWidth / 1.4f);
+    const int reach = std::max(1, int(std::ceil(14.f * scale / span)));
+    for (int dz = -reach; dz <= reach; ++dz)
+        for (int dx = -reach; dx <= reach; ++dx) {
+            int a = ix + dx, b = iz + dz;
+            if (hash(a, b, salt) > (layer ? .35f / float(layer) : .9f))
+                continue;
+            float px = (a + .15f + .7f * hash(a, b, salt ^ 31)) * span,
+                  pz = (b + .15f + .7f * hash(a, b, salt ^ 53)) * span;
+            float angle = hash(a, b, salt ^ 79) * 2 * Pi;
+            auto v = rotateY({x - px, 0, z - pz}, angle);
+            float rx = ((layer ? 5.f : 7.f) + 3 * hash(a, b, salt ^ 101)) * scale,
+                  rz = ((layer ? 4.f : 5.5f) + (layer ? 3.f : 3.5f) * hash(a, b, salt ^ 127)) * scale;
+            float u = v.x / rx, w = v.z / rz, theta = std::atan2(w, u);
+            float shape = 1 + (p.silhouette / .9f) *
+                                  (.12f * std::sin(3 * theta + angle) + .06f * std::sin(5 * theta - angle));
+            float field = (shape - std::hypot(u, w)) * std::min(rx, rz);
+            float blend = 4.f * scale;
+            float overlap = std::max(0.f, blend - std::abs(result - field)) / blend;
+            result = std::max(result, field) + .25f * blend * overlap * overlap;
+        }
+    return result;
+}
