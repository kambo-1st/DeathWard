{"parse": {"title": "Grub", "pageid": 7578, "revid": 310158, "redirects": [], "text": "<div class=\"mw-content-ltr mw-parser-output\" lang=\"en\" dir=\"ltr\"><p class=\"mw-empty-elt\">\n</p><aside role=\"region\" class=\"portable-infobox pi-background pi-border-color pi-theme-wikia pi-layout-stacked\">\n<h2 class=\"pi-item pi-item-spacing pi-title pi-secondary-background\" data-source=\"name\"><div class=\"infobox2-slideshow dlc-slideshow\"><div class=\"infobox2-slide\"><span style=\"white-space:nowrap\"><span typeof=\"mw:File\"><span><img alt=\"G\" src=\"https://static.wikia.nocookie.net/bindingofisaacre_gamepedia/images/9/99/Font_TeamMeat_G.png/revision/latest?cb=20210822055450\" decoding=\"async\" loading=\"lazy\" width=\"25\" height=\"27\" class=\"mw-file-element\" data-image-name=\"Font TeamMeat G.png\" data-image-key=\"Font_TeamMeat_G.png\" data-relevant=\"0\" /></span></span><span typeof=\"mw:File\"><span><img alt=\"r\" src=\"https://static.wikia.nocookie.net/bindingofisaacre_gamepedia/images/1/1e/Font_TeamMeat_r.png/revision/latest?cb=20210822061013\" decoding=\"async\" loading=\"lazy\" width=\"18\" height=\"13\" class=\"mw-file-element\" data-image-name=\"Font TeamMeat r.png\" data-image-key=\"Font_TeamMeat_r.png\" data-relevant=\"0\" /></span></span><span typeof=\"mw:File\"><span><img alt=\"u\" src=\"https://static.wikia.nocookie.net/bindingofisaacre_gamepedia/images/7/7e/Font_TeamMeat_u.png/revision/latest?cb=20210822061129\" decoding=\"async\" loading=\"lazy\" width=\"18\" height=\"15\" class=\"mw-file-element\" data-image-name=\"Font TeamMeat u.png\" data-image-key=\"Font_TeamMeat_u.png\" data-relevant=\"0\" /></span></span><span typeof=\"mw:File\"><span><img alt=\"b\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"17\" height=\"15\" class=\"mw-file-element lazyload\" data-image-name=\"Font TeamMeat b.png\" data-image-key=\"Font_TeamMeat_b.png\" data-relevant=\"0\" data-src=\"https://static.wikia.nocookie.net/bindingofisaacre_gamepedia/images/a/ac/Font_TeamMeat_b.png/revision/latest?cb=20210822060349\" /></span></span></span></div></div></h2>\n\n<div class=\"pi-item pi-data pi-item-spacing pi-border-color\" data-source=\"image\">\n\t\n\t\t<h3 class=\"pi-data-label pi-secondary-font\">Entity Image</h3>\n\t\n\t<div class=\"pi-data-value pi-font\"><div class=\"infobox2-slideshow dlc-slideshow\"><div class=\"infobox2-slide\"><span class=\"mw-default-size dlc dlc-7 infobox2-slide-title\" typeof=\"mw:File\"><span title=\"Removed in Repentance\"><img alt=\"(except in Repentance)\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"31\" height=\"14\" class=\"mw-file-element lazyload\" data-image-name=\"Dlc nr indicator.png\" data-image-key=\"Dlc_nr_indicator.png\" data-relevant=\"0\" data-src=\"https://static.wikia.nocookie.net/bindingofisaacre_gamepedia/images/0/04/Dlc_nr_indicator.png/revision/latest?cb=20241126195308\" /></span></span> <span typeof=\"mw:File\"><span title=\"Entity image\"><img alt=\"Entity image\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"264\" height=\"102\" class=\"mw-file-element lazyload\" data-image-name=\"Grub Rebirth.png\" data-image-key=\"Grub_Rebirth.png\" data-relevant=\"0\" data-src=\"https://static.wikia.nocookie.net/bindingofisaacre_gamepedia/images/5/5b/Grub_Rebirth.png/revision/latest?cb=20210824170608\" /></span></span></div><div class=\"infobox2-slide\"><span class=\"mw-default-size dlc dlc-8 infobox2-slide-title\" typeof=\"mw:File\"><span title=\"Added in Repentance\"><img alt=\"(in Repentance)\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"31\" height=\"14\" class=\"mw-file-element lazyload\" data-image-name=\"Dlc r ind