yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"50\" height=\"35\" class=\"mw-file-element lazyload\" data-image-name=\"Stage Ashpit icon.png\" data-image-key=\"Stage_Ashpit_icon.png\" data-relevant=\"0\" data-src=\"https://static.wikia.nocookie.net/bindingofisaacre_gamepedia/images/c/cf/Stage_Ashpit_icon.png/revision/latest?cb=20210825172340\" /></a></span><br /><span typeof=\"mw:File\"><a href=\"/wiki/Challenge_Room\" title=\"Challenge Room\"><img alt=\"Challenge Room Icon\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"27\" height=\"24\" class=\"mw-file-element lazyload\" data-image-name=\"Challenge Room Icon.png\" data-image-key=\"Challenge_Room_Icon.png\" data-relevant=\"0\" data-src=\"https://static.wikia.nocookie.net/bindingofisaacre_gamepedia/images/1/1b/Challenge_Room_Icon.png/revision/latest?cb=20210821102142\" /></a></span></div>\n</div>\n</aside>\n<p class=\"mw-empty-elt\"></p><div id=\"context-page\" class=\"context-box\"><span class=\"mw-default-size dlc dlc-8\" typeof=\"mw:File\"><span title=\"Added in Repentance\"><img alt=\"(in Repentance)\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"31\" height=\"14\" class=\"mw-file-element lazyload\" data-image-name=\"Dlc r indicator.png\" data-image-key=\"Dlc_r_indicator.png\" data-relevant=\"0\" data-src=\"https://static.wikia.nocookie.net/bindingofisaacre_gamepedia/images/f/f2/Dlc_r_indicator.png/revision/latest?cb=20210815090252\" /></span></span> </div> <div class=\"disambig-notice\">This article is about the monster found in <span class=\"inline-icon\" typeof=\"mw:File\"><a href=\"/wiki/Mines\" title=\"Mines\"><img alt=\"Mines\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"20\" height=\"14\" class=\"mw-file-element lazyload\" data-image-name=\"Stage Mines icon.png\" data-image-key=\"Stage_Mines_icon.png\" data-relevant=\"0\" data-src=\"https://static.wikia.nocookie.net/bindingofisaacre_gamepedia/images/5/58/Stage_Mines_icon.png/revision/latest/scale-to-width-down/20?cb=20210825172320\" /></a></span><a href=\"/wiki/Mines\" title=\"Mines\">Mines</a>.&#32;For other uses, see <a href=\"/wiki/Danny_(Disambiguation)\" class=\"mw-disambig\" title=\"Danny (Disambiguation)\">Danny (Disambiguation)</a>.</div> \n<p><b>Dannies</b> are an enemy added in <i><a href=\"/wiki/The_Binding_of_Isaac:_Repentance\" title=\"The Binding of Isaac: Repentance\">The Binding of Isaac: Repentance</a></i>. They are exclusive to <span class=\"inline-icon\" typeof=\"mw:File\"><a href=\"/wiki/Mines\" title=\"Mines\"><img alt=\"Mines\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"20\" height=\"14\" class=\"mw-file-element lazyload\" data-image-name=\"Stage Mines icon.png\" data-image-key=\"Stage_Mines_icon.png\" data-relevant=\"0\" data-src=\"https://static.wikia.nocookie.net/bindingofisaacre_gamepedia/images/5/58/Stage_Mines_icon.png/revision/latest/scale-to-width-down/20?cb=20210825172320\" /></a></span><a href=\"/wiki/Mines\" title=\"Mines\">Mines</a> and <span class=\"inline-icon\" typeof=\"mw:File\"><a href=\"/wiki/Ashpit\" title=\"Ashpit\"><img alt=\"Ashpit\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"20\" height=\"14\" class=\"mw-file-element lazyload\" data-image-name=\"Stage Ashpit icon.png\" data-image-key=\"Stage_Ashpit_icon.png\" data-relevant=\"0\" data-src=\"https://static.wikia.nocookie.net/bindingofisaacre_gamepedia/images/c/cf/Stage_Ashpit_icon.png/revision/latest/scale-to-width-down/20?cb=20210825172340\" /></a></span><a href=\"/wiki/Ashpit\" title=\"Ashpit\">Ashpit</a>.\n</p><p>They walk towards Isaac, periodically spitting a burst of rocks towards him, up to two of which may be &#32;<span class=\"inline-icon\" typeof=\"mw:File\"><a href=\"/wiki/Rock_Spider\" title=\"Rock Spider\"><img alt=\"Rock Spider\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"20\" height=\"16\" class=\"mw-file-element lazyload\" data-image-name=\"Rock Spider.png\" data-image-key=\"Rock_Spider.png\" data-relevant=\"0\" data-src=\"https://static.wikia.nocookie.net/bindingofisaacre_gamepedia/images/f/f0/Rock_Spider.png/revision/latest?cb=20210408221719\" /></a></span><a href=\"/wiki/Rock_Spider\" title=\"Rock Spider\">Rock Spiders</a>. Their rock bursts cannot spawn Rock Spiders if the two it spawned are still alive. Dannies have a long cooldown between rock bursts, but are more likely to use it soon after Isaac enters the room.\n</p>\n<div style=\"clear:both\"></div>\n<h2><span class=\"mw-headline\" id=\"Variants\">Variants</span></h2>\n<h3><span class=\"mw-headline\" id=\"Coal_Boy\">Coal Boy</span></h3><p class=\"mw-empty-elt\">\n\n</p><aside role=\"region\" class=\"portable-infobox pi-background pi-border-color pi-theme-wikia pi-layout-stacked\">\n<h2 class=\"pi-item pi-item-spacing pi-title pi-secondary-background\" data-source=\"name\"><div class=\"infobox2-slideshow dlc-slideshow\"><div class=\"infobox2-slide\"><span style=\"white-space:nowrap\"><span typeof=\"mw:File\"><span><img alt=\"C\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"20\" height=\"23\" class=\"mw-file-element lazyload\" data-image-name=\"Font TeamMeat C.png\" data-image-key=\"Font_TeamMeat_C.png\" data-relevant=\"0\" data-src=\"https://static.wikia.nocookie.net/bindingofisaacre_gamepedia/images/8/8c/Font_TeamMeat_C.png/revision/latest?cb=20210822055314\" /></span></span><span typeof=\"mw:File\"><span><img alt=\"o\