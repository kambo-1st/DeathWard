i-secondary-font pi-item-spacing pi-border-color\" style=\"width: calc(1 / 2 * 100%);\" data-source=\"base hp\">Base HP</h3>\n            \n                <h3 class=\"pi-smart-data-label pi-data-label pi-secondary-font pi-item-spacing pi-border-color\" style=\"width: calc(1 / 2 * 100%);\" data-source=\"stage hp\">Stage HP</h3>\n            \n        </section>\n    \n    <section class=\"pi-smart-group-body pi-border-color\">\n        \n            <div class=\"pi-smart-data-value pi-data-value pi-font pi-item-spacing pi-border-color\" style=\"width: calc(1 / 2 * 100%);\" data-source=\"base hp\"><div class=\"infobox2-slideshow dlc-slideshow\"><div class=\"infobox2-slide\"> <span class=\"pi-custom-font\">20</span></div></div></div>\n        \n            <div class=\"pi-smart-data-value pi-data-value pi-font pi-item-spacing pi-border-color\" style=\"width: calc(1 / 2 * 100%);\" data-source=\"stage hp\"><div class=\"infobox2-slideshow dlc-slideshow\"><div class=\"infobox2-slide\"> <span class=\"pi-custom-font\">0</span></div></div></div>\n        \n    </section>\n</section>\n\n</section>\n\n<div class=\"pi-item pi-data pi-item-spacing pi-border-color\" data-source=\"id\">\n\t\n\t\t<h3 class=\"pi-data-label pi-secondary-font\">Entity ID</h3>\n\t\n\t<div class=\"pi-data-value pi-font\"><code>231.1</code></div>\n</div>\n\n<div class=\"pi-item pi-data pi-item-spacing pi-border-color\" data-source=\"environment\">\n\t\n\t\t<h3 class=\"pi-data-label pi-secondary-font\">Found In</h3>\n\t\n\t<div class=\"pi-data-value pi-font\"><span typeof=\"mw:File\"><a href=\"/wiki/Womb\" title=\"Womb\"><img alt=\"Stage Womb icon\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"50\" height=\"35\" class=\"mw-file-element lazyload\" data-image-name=\"Stage Womb icon.png\" data-image-key=\"Stage_Womb_icon.png\" data-relevant=\"0\" data-src=\"https://static.wikia.nocookie.net/bindingofisaacre_gamepedia/images/4/4c/Stage_Womb_icon.png/revision/latest?cb=20210826073122\" /></a></span><span typeof=\"mw:File\"><a href=\"/wiki/Utero\" title=\"Utero\"><img alt=\"Stage Utero icon\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"50\" height=\"35\" class=\"mw-file-element lazyload\" data-image-name=\"Stage Utero icon.png\" data-image-key=\"Stage_Utero_icon.png\" data-relevant=\"0\" data-src=\"https://static.wikia.nocookie.net/bindingofisaacre_gamepedia/images/3/3d/Stage_Utero_icon.png/revision/latest?cb=20210826073102\" /></a></span><span typeof=\"mw:File\"><a href=\"/wiki/Scarred_Womb\" title=\"Scarred Womb\"><img alt=\"Stage Scarred Womb icon\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"50\" height=\"35\" class=\"mw-file-element lazyload\" data-image-name=\"Stage Scarred Womb icon.png\" data-image-key=\"Stage_Scarred_Womb_icon.png\" data-relevant=\"0\" data-src=\"https://static.wikia.nocookie.net/bindingofisaacre_gamepedia/images/a/af/Stage_Scarred_Womb_icon.png/revision/latest?cb=20210826073303\" /></a></span><br />Chance to replace &#32;<span class=\"inline-icon\" typeof=\"mw:File\"><a href=\"/wiki/Nerve_Ending\" title=\"Nerve Ending\"><img alt=\"Nerve Ending\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"10\" height=\"20\" class=\"mw-file-element lazyload\" data-image-name=\"Nerve Ending.png\" data-image-key=\"Nerve_Ending.png\" data-relevant=\"0\" data-src=\"https://static.wikia.nocookie.net/bindingofisaacre_gamepedia/images/e/e3/Nerve_Ending.png/revision/latest/scale-to-width-down/10?cb=20210821101149\" /></a></span><strong class=\"mw-selflink selflink\">Nerve Endings</strong></div>\n</div>\n\n<div class=\"pi-item pi-data pi-item-spacing pi-border-color\" data-source=\"unlocked by\">\n\t\n\t\t<h3 class=\"pi-data-label pi-secondary-font\">Unlock Method</h3>\n\t\n\t<div class=\"pi-data-value pi-font\"><span typeof=\"mw:File\"><a href=\"/wiki/Portal\" title=\"The gate is open!\"><img alt=\"The gate is open!\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"20\" height=\"20\" class=\"mw-file-element lazyload\" data-image-name=\"Achievement The gate is open! icon.png\" data-image-key=\"Achievement_The_gate_is_open%21_icon.png\" data-relevant=\"0\" data-src=\"https://static.wikia.nocookie.net/bindingofisaacre_gamepedia/images/9/98/Achievement_The_gate_is_open%21_icon.png/revision/latest/scale-to-width-down/20?cb=20210822063058\" /></a></span> Defeat <a href=\"/wiki/The_Lamb\" title=\"The Lamb\">The Lamb</a></div>\n</div>\n</aside>\n<p class=\"mw-empty-elt\"></p><div class=\"context-box\"><span class=\"mw-default-size dlc dlc-12\" typeof=\"mw:File\"><span title=\"Added in Afterbirth †\"><img alt=\"(in Afterbirth † and Repentance)\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"31\" height=\"14\" class=\"mw-file-element lazyload\" data-image-name=\"Dlc a† indicator.png\" data-image-key=\"Dlc_a%E2%80%A0_indicator.png\" data-relevant=\"0\" data-src=\"https://static.wikia.nocookie.net/bindingofisaacre_gamepedia/images/4/4c/Dlc_a%E2%80%A0_indicator.png/revision/latest?cb=20220204205709\" /></span></span> </div>\n<p><b>Nerve Ending 2s</b> are stationary enemies which will swipe at Isaac if he gets too close. This attack can only connect if Isaac is horizontal with it, but will deal contact damage in any case if Isaac walks into them. Otherwise, they have no means of attacking and are generally harmless.\n</p>\n<h4><span class=\"mw-headline\" id=\"Notes\">Notes</span></h4>\n<ul><li>Nerve Ending 2 can never replace regular Nerve Endings next to doors.</li>\n<li>If Nerve Ending 2s aren't unlocked yet, they are replaced by Nerve Endings.</li></ul>\n<div style=\"clear:both\"></div>\n<h2><span class=\"mw-headline\" id=\"Trivia\">Trivia</span></h2>\n<ul><li>It's possible that the Nerve Ending is a giant axon, an electrical impulse terminal for nerve cells, which could explain its name.</li></ul>\n<p><br class=\"content-filter-end\" /></p><div class=\"nav-start\" style=\"clear: both\"></div>\n<table class=\"nav-box nav-main\">\n<tbody><tr>\n<th class=\"nav-title\"><span class=\"no-alt\" typeof=\"mw:File\"><span><img alt=\"SmallIsaac\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"30\" height=\"30\" class=\"mw-file-element lazyload\" data-image-name=\"SmallIsaac.png\" data-image-key=\"SmallIsaac.png\" data-relevant=\"0\" data-src=\"https://static.wikia.nocookie.net/bindingofisaacre_gamepedia/images/a/a6/SmallIsaac.png/revision/latest?cb=20210821194340\" /></span></span><a href=\"/wiki/Binding_of_Isaac:_Rebirth_Wiki\" title=\"Binding of Isaac: Rebirth Wiki\">The Binding of Isaac: Rebirth</a><span class=\"no-alt\" typeof=\"mw:File\"><span><img alt=\"SmallIsaac\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"30\" height=\"30\" class=\"mw-file-element lazyload\" data-image-name=\"SmallIsaac.png\" data-image-key=\"SmallIsaac.png\" data-relevant=\"0\" data-src=\"https://static.wikia.nocookie.net/bindingofisaacre_gamepedia/images/a/a6/SmallIsaac.png/revision/latest?cb=20210821194340\" /></span></span>\n</th></tr>\n<tr>\n<td>\n<ul><li><span class=\"inline-icon\" typeof=\"mw:File\"><a href=\"/wiki/Achievements\" title=\"Achievements\"><img alt=\"MainPageAchievements\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"20\" height=\"17\" class=\"mw-file-element lazyload\" data-image-name=\"M