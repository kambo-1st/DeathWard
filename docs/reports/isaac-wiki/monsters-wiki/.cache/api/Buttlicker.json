revision/latest?cb=20210826073002\" /></a></span><span typeof=\"mw:File\"><a href=\"/wiki/Necropolis\" title=\"Necropolis\"><img alt=\"Stage Necropolis icon\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"50\" height=\"35\" class=\"mw-file-element lazyload\" data-image-name=\"Stage Necropolis icon.png\" data-image-key=\"Stage_Necropolis_icon.png\" data-relevant=\"0\" data-src=\"https://static.wikia.nocookie.net/bindingofisaacre_gamepedia/images/2/2d/Stage_Necropolis_icon.png/revision/latest?cb=20210826073022\" /></a></span><span typeof=\"mw:File\"><a href=\"/wiki/Dank_Depths\" title=\"Dank Depths\"><img alt=\"Stage Dank Depths icon\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"50\" height=\"35\" class=\"mw-file-element lazyload\" data-image-name=\"Stage Dank Depths icon.png\" data-image-key=\"Stage_Dank_Depths_icon.png\" data-relevant=\"0\" data-src=\"https://static.wikia.nocookie.net/bindingofisaacre_gamepedia/images/0/04/Stage_Dank_Depths_icon.png/revision/latest?cb=20210826073222\" /></a></span><br /><span typeof=\"mw:File\"><a href=\"/wiki/Challenge_Room\" title=\"Challenge Room\"><img alt=\"Challenge Room Icon\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"27\" height=\"24\" class=\"mw-file-element lazyload\" data-image-name=\"Challenge Room Icon.png\" data-image-key=\"Challenge_Room_Icon.png\" data-relevant=\"0\" data-src=\"https://static.wikia.nocookie.net/bindingofisaacre_gamepedia/images/1/1b/Challenge_Room_Icon.png/revision/latest?cb=20210821102142\" /></a></span></div>\n</div>\n</aside>\n\n<p class=\"mw-empty-elt\"></p><p><b>Buttlickers</b> are monsters that wander around randomly in straight lines similar to &#32;<span class=\"inline-icon\" typeof=\"mw:File\"><a href=\"/wiki/Larry_Jr.\" title=\"Larry Jr.\"><img alt=\"Boss Larry Jr. ingame\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"20\" height=\"8\" class=\"mw-file-element lazyload\" data-image-name=\"Boss Larry Jr. ingame.png\" data-image-key=\"Boss_Larry_Jr._ingame.png\" data-relevant=\"0\" data-src=\"https://static.wikia.nocookie.net/bindingofisaacre_gamepedia/images/9/9a/Boss_Larry_Jr._ingame.png/revision/latest/scale-to-width-down/20?cb=20210822103445\" /></a></span><a href=\"/wiki/Larry_Jr.\" title=\"Larry Jr.\">Larry Jr.</a>.\nThey most often spawn attached to other Buttlickers in chains of up to 5. When one Buttlicker in the chain is destroyed, the other Buttlickers separate from each other and continue to move in random directions.\n</p><p>Similar to Larry Jr., Buttlickers can destroy Poop on contact.\n</p>\n<div style=\"clear:both\"></div>\n\n<h2><span class=\"mw-headline\" id=\"Variants\">Variants</span></h2>\n<h3><span class=\"mw-headline\" id=\"Butt_Slicker\">Butt Slicker</span></h3><p class=\"mw-empty-elt\">\n\n</p><aside role=\"region\" class=\"portable-infobox pi-background pi-border-color pi-theme-wikia pi-layout-stacked\">\n<h2 class=\"pi-item pi-item-spacing pi-title pi-secondary-background\" data-source=\"name\"><div class=\"infobox2-slideshow dlc-slideshow\"><div class=\"infobox2-slide\"><span style=\"white-space:nowrap\"><span typeof=\"mw:File\"><span><img alt=\"B\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"23\" height=\"26\" class=\"mw-file-element lazyload\" data-image-name=\"Font TeamMeat B.png\" data-image-key=\"Font_TeamMeat_B.png\" data-relevant=\"0\" data-src=\"https://static.wikia.nocookie.net/bindingofisaacre_gamepedia/images/2/2a/Font_TeamMeat_B.png/revision/latest?cb=20210822055249\" /></span></span><span typeof=\"mw:File\"><span><img alt=\"u\" src=\"data:image/gif;