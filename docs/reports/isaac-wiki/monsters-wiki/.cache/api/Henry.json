{"parse": {"title": "Henry", "pageid": 25594, "revid": 315820, "redirects": [], "text": "<div class=\"mw-content-ltr mw-parser-output\" lang=\"en\" dir=\"ltr\"><p class=\"mw-empty-elt\">\n</p><aside role=\"region\" class=\"portable-infobox pi-background pi-border-color pi-theme-wikia pi-layout-stacked\">\n<h2 class=\"pi-item pi-item-spacing pi-title pi-secondary-background\" data-source=\"name\"><div class=\"infobox2-slideshow dlc-slideshow\"><div class=\"infobox2-slide\"><span style=\"white-space:nowrap\"><span typeof=\"mw:File\"><span><img alt=\"H\" src=\"https://static.wikia.nocookie.net/bindingofisaacre_gamepedia/images/f/fe/Font_TeamMeat_H.png/revision/latest?cb=20210822055513\" decoding=\"async\" loading=\"lazy\" width=\"23\" height=\"26\" class=\"mw-file-element\" data-image-name=\"Font TeamMeat H.png\" data-image-key=\"Font_TeamMeat_H.png\" data-relevant=\"0\" /></span></span><span typeof=\"mw:File\"><span><img alt=\"e\" src=\"https://static.wikia.nocookie.net/bindingofisaacre_gamepedia/images/8/8a/Font_TeamMeat_e.png/revision/latest?cb=20210822060501\" decoding=\"async\" loading=\"lazy\" width=\"18\" height=\"15\" class=\"mw-file-element\" data-image-name=\"Font TeamMeat e.png\" data-image-key=\"Font_TeamMeat_e.png\" data-relevant=\"0\" /></span></span><span typeof=\"mw:File\"><span><img alt=\"n\" src=\"https://static.wikia.nocookie.net/bindingofisaacre_gamepedia/images/0/04/Font_TeamMeat_n.png/revision/latest?cb=20210822060837\" decoding=\"async\" loading=\"lazy\" width=\"17\" height=\"15\" class=\"mw-file-element\" data-image-name=\"Font TeamMeat n.png\" data-image-key=\"Font_TeamMeat_n.png\" data-relevant=\"0\" /></span></span><span typeof=\"mw:File\"><span><img alt=\"r\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"18\" height=\"13\" class=\"mw-file-element lazyload\" data-image-name=\"Font TeamMeat r.png\" data-image-key=\"Font_TeamMeat_r.png\" data-relevant=\"0\" data-src=\"https://static.wikia.nocookie.net/bindingofisaacre_gamepedia/images/1/1e/Font_TeamMeat_r.png/revision/latest?cb=20210822061013\" /></span></span><span typeof=\"mw:File\"><span><img alt=\"y\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"15\" height=\"17\" class=\"mw-file-element lazyload\" data-image-name=\"Font TeamMeat y.png\" data-image-key=\"Font_TeamMeat_y.png\" data-relevant=\"0\" data-src=\"https://static.wikia.nocookie.net/bindingofisaacre_gamepedia/images/6/6b/Font_TeamMeat_y.png/revision/latest?cb=20210822061303\" /></span></span></span></div></div></h2>\n\n<div class=\"pi-item pi-data pi-item-spacing pi-border-color\" data-source=\"image\">\n\t\n\t\t<h3 class=\"pi-data-label pi-secondary-font\">Entity Image</h3>\n\t\n\t<div class=\"pi-data-value pi-font\"><div class=\"infobox2-slideshow dlc-slideshow\"><div class=\"infobox2-slide\"><span typeof=\"mw:File\"><span title=\"Entity image\"><img alt=\"Entity image\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"99\" height=\"198\" class=\"mw-file-element lazyload\" data-image-name=\"Henry.png\" data-image-key=\"Henry.png\" data-relevant=\"0\" data-src=\"https://static.wikia.nocookie.net/bindingofisaacre_gamepedia/images/1/1e/Henry.png/revision/latest?cb=20210824140139\" /></span></span></div></div><br /></div>\n</div>\n<section class=\"pi-item pi-group pi-border-color\">\n\t<section class=\"pi-item pi-smart-group pi-border-color\">\n    \n        <section class=\"pi-smart-group-head pi-border-color\">\n            \n                <h3 class=\"pi-smart-data-label pi-data-label pi-secondary-font pi-item-spacing pi-border-color\" style=\"width: calc(1 / 2 * 100%);\" data-source=\"base hp\">Base HP</h3>\n            \n                <h3 class=\"pi-smart-data-label pi-data-label pi-secondary-font pi-item-spacing pi-border-color\" style=\"width: calc(1 / 2 * 100%);\" data-source=\"stage hp\">Stage HP</h3>\n            \n        </section>\n    \n    <section class=\"pi-smart-group-body pi-border-color\">\n        \n            <div class=\"pi-smart-data-value pi-data-value pi-font pi-item-spacing pi-border-color\" style=\"width: calc(1 / 2 * 100%);\" data-source=\"base hp\"><div class=\"infobox2-slideshow dlc-slideshow\"><div class=\"infobox2-slide\"> <span class=\"pi-custom-font\">80</span></div></div></div>\n        \n            <div class=\"pi-smart-data-value pi-data-value pi-font pi-item-spacing pi-border-color\" style=\"width: calc(1 / 2 * 100%);\" data-source=\"stage hp\"><div class=\"infobox2-slideshow dlc-slideshow\"><div class=\"infobox2-slide\"> <span class=\"pi-custom-font\">0</span></div></div></div>\n        \n    </section>\n</section>\n\n</section>\n\n<div class=\"pi-item pi-data pi-item-spacing pi-border-color\" data-source=\"id\">\n\t\n\t\t<h3 class=\"pi-data-label pi-secondary-font\">Entity ID</h3>\n\t\n\t<div class=\"pi-data-value pi-font\"><code>837.0</code></div>\n</div>\n\n<div class=\"pi-item pi-data pi-item-spacing pi-border-color\" data-source=\"environment\">\n\t\n\t\t<h3 class=\"pi-data-label pi-secondary-font\">Found In</h3>\n\t\n\t<div class=\"pi-data-value pi-font\"><span typeof=\"mw:File\"><a href=\"/wiki/Dross\" title=\"Dross\"><img alt=\"Stage Dross icon\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"50\" height=\"35\" class=\"mw-file-element lazyload\" data-image-name=\"Stage Dross icon.png\" data-image-key=\"Stage_Dross_icon.png\" data-relevant=\"0\" data-src=\"https://static.wikia.nocookie.net/bindingofisaacre_gamepedia/images/a/a2/Stage_Dross_icon.png/revision/latest?cb=20210825172300\" /></a></span></div>\n</div>\n</aside>\n<p class=\"mw-empty-elt\"></p><div id=\"context-page\" class=\"context-box\"><span class=\"mw-default-size dlc dlc-8\" typeof=\"mw:File\"><span title=\"Added in Repentance\"><img alt=\"(in Repentance)\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"31\" height=\"14\" class=\"mw-file-element lazyload\" data-image-name=\"Dlc r indicator.png\" data-image-key=\"Dlc_r_indicator.png\" data-relevant=\"0\" data-src=\"https://static.wikia.nocookie.net/bindingofisaacre_gamepedia/images/f/f2/Dlc_r_indicator.png/revision/latest?cb=20210815090252\" /></span></span> </div>\n<p><b>Henry</b> is a monster added in <i><a href=\"/wiki/The_Binding_of_Isaac:_Repentance\" title=\"The Binding of Isaac: Repentance\">The Binding of Isaac: Repentance</a></i> DLC and is exclusively found in <span class=\"inline-icon\" typeof=\"mw:File\"><a href=\"/wiki/Dross\" title=\"Dross\"><img alt=\"Dross\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"20\" height=\"14\" class=\"mw-file-element lazyload\" data-image-name=\"Stage Dross icon.png\" data-image-key=\"Stage_Dross_icon.png\" data-relevant=\"0\" data-src=\"https://static.wikia.nocookie.net/bindingofisaacre_gamepedia/images/a/a2/Stage_Dross_icon.png/revision/latest/scale-to-width-down/20?cb=20210825172300\" /></a></span><a href=\"/wiki/Dross\" title=\"Dross\">Dross</a>.\n</p><p>Henry appears only in a single extremely rare room within the floor. When Isaac enters the room, Henry smiles and then gets flushed down a drain. Isaac can fire tears at it, but due to its high HP it is extremely difficult to kill, and would be pointless anyway as its only behavior is killing itself.\n</p>\n<h2><span class=\"mw-headline\" id=\"Notes\">Notes</span></h2>\n<ul><li><span class=\"tooltip\" data-tooltip=\"i/tooltip&#124;Friendly+Ball&#124;8\"><span class=\"inline-icon\" typeof=\"mw:File\"><a href=\"/wiki/Friendly_Ball\" title=\"Friendly Ball\"><img alt=\"Collectible Friendly Ball icon\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"20\" height=\"20\" class=\"mw-file-element lazyload\" data-image-name=\"Collectible Friendly Ball icon.png\" data-image-key=\"Collectible_Friendly_Ball_icon.png\" data-relevant=\"0\" data-src=\"https://static.wikia.nocookie.net/bindingofisaacre_gamepedia/images/f/f1/Collectible_Friendly_Ball_icon.png/revision/latest/scale-to-width-down/20?cb=20210821162131\" /></a></span><a href=\"/wiki/Friendly_Ball\" title=\"Friendly Ball\">Friendly Ball</a></span> can be used to capture Henry, although when released, it will still flush itself away like usual, doing no damage to enemies. It also does not spawn properly if the room lacks a pit.</li>\n<li>Although Henry does not attack Isaac directly, it can still deal contact damage if the player has flight.\n<ul><li>Henry does not have its own kill icon, so if Isaac somehow manages to die from him, the death screen will instead show a <a href=\"/wiki/Rocks#Buckets\" title=\"Rocks\">bucket</a> as the cause of death.</li></ul></li>\n<li>Henry does not appear in the game's <a href=\"/wiki/Bestiary\" title=\"Bestiary\">Bestiary</a>, and as such, does not need to be killed to complete it.</li>\n<li>The room in which Henry spawns has an ID of 485 and has a weight of 0.01. The rarity is further compounded by the room requiring a dead end with only a south exit, and as such cannot be generated by <span class=\"tooltip\" data-tooltip=\"i/tooltip&#124;Red+Key&#124;8\"><span class=\"inline-icon\" typeof=\"mw:File\"><a href=\"/wiki/Red_Key\" title=\"Red Key\"><img alt=\"Collectible Red Key icon\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"20\" height=\"20\" class=\"mw-file-element lazyload\" data-image-name=\"Collectible Red Key icon.png\" data-image-key=\"Collectible_Red_Key_icon.png\" data-relevant=\"0\" data-src=\"https://static.wikia.nocookie.net/bindingofisaacre_gamepedia/images/1/1f/Collectible_Red_Key_icon.png/revision/latest/scale-to-width-down/20?cb=20230111000649\" /></a></span><a href=\"/wiki/Red_Key\" title=\"Red Key\">Red Key</a></span>.</li>\n<li>Using <span class=\"tooltip\" data-tooltip=\"i/tooltip&#124;Flush%21&#124;8\"><span class=\"inline-icon\" typeof=\"mw:File\"><a href=\"/wiki/Flush!\" title=\"Flush!\"><img alt=\"Collectible Flush! icon\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"20\" height=\"20\" class=\"mw-file-element lazyload\" data-image-name=\"Collectible Flush! icon.png\" data-image-key=\"Collectible_Flush%21_icon.png\" data-relevant=\"0\" data-src=\"https://static.wikia.nocookie.net/bindingofisaacre_gamepedia/images/7/74/Collectible_Flush%21_icon.png/revision/latest/scale-to-width-down/20?cb=20210821050914\" /></a></span><a href=\"/wiki/Flush!\" title=\"Flush!\">Flush!</a></span> on Henry will not flush him, instead turning him into poop.</li></ul>\n<h2><span class=\"mw-headline\" id=\"In-game_footage\">In-game footage</span></h2>\n<div class=\"thumb embedvideo autoResize\" style=\"width: 408px;\">\n\t\t\t<div class=\"embedvideo autoResize\" style=\"\">\n\t\t\t\t<div class=\"embedvideowrap\" style=\"width: 400px;\">\n<p>\t\t\t\t\t<iframe title=\"Play video\" src=\"//www.youtube.com/embed/uul31Rg8awc?\" width=\"400\" height=\"225\" style=\"border: none;\" allowfullscreen=\"true\" loading=\"lazy\"></iframe>\n</p>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t</div>\n<h2><span class=\"mw-headline\" id=\"Trivia\">Trivia</span></h2>\n<ul><li>Henry was initially a design by Kilburn, and Edmund McMillen suggested that <a target=\"_blank\" rel=\"nofollow noreferrer noopener\" class=\"external text\" href=\"https://twitter.com/edmundmcmillen/status/1481167488117211136\">its behavior be doing nothing and being super rare</a>, which matches its status today.</li></ul>\n<p><br class=\"content-filter-end\" /></p><div class=\"nav-start\" style=\"clear: both\"></div>\n<table class=\"nav-box nav-main\">\n<tbody><tr>\n<th class=\"nav-title\"><span class=\"no-alt\" typeof=\"mw:File\"><span><img alt=\"SmallIsaac\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"30\" height=\"30\" class=\"mw-file-element lazyload\" data-image-name=\"SmallIsaac.png\" data-image-key=\"SmallIsaac.png\" data-relevant=\"0\" data-src=\"https://static.wikia.nocookie.net/bindingofisaacre_gamepedia/images/a/a6/SmallIsaac.png/revision/latest?cb=20210821194340\" /></span></span><a href=\"/wiki/Binding_of_Isaac:_Rebirth_Wiki\" title=\"Binding of Isaac: Rebirth Wiki\">The Binding of Isaac: Rebirth</a><span class=\"no-alt\" typeof=\"mw:File\"><span><img alt=\"SmallIsaac\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"30\" height=\"30\" class=\"mw-file-element lazyload\" data-image-name=\"SmallIsaac.png\" data-image-key=\"SmallIsaac.png\" data-relevant=\"0\" data-src=\"https://static.wikia.nocookie.net/bindingofisaacre_gamepedia/images/a/a6/SmallIsaac.png/revision/latest?cb=20210821194340\" /></span></span>\n</th></tr>\n<tr>\n<td>\n<ul><li><span class=\"inline-icon\" typeof=\"mw:File\"><a href=\"/wiki/Achievements\" title=\"Achievements\"><img alt=\"MainPageAchievements\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"20\" height=\"17\" class=\"mw-file-element lazyload\" data-image-name=\"MainPageAchievements.png\" data-image-key=\"MainPageAchievements.png\" data-relevant=\"0\" data-src=\"https://static.wikia.nocookie.net/bindingofisaacre_gamepedia/images/2/26/MainPageAchievements.png/revision/latest/scale-to-width-down/20?cb=20151124025857\" /></a></span><a href=\"/wiki/Achievements\" title=\"Achievements\">Achi