ges/0/04/Stage_Dank_Depths_icon.png/revision/latest?cb=20210826073222\" /></a></span><br /><span typeof=\"mw:File\"><a href=\"/wiki/Cathedral\" title=\"Cathedral\"><img alt=\"Stage Cathedral icon\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"50\" height=\"35\" class=\"mw-file-element lazyload\" data-image-name=\"Stage Cathedral icon.png\" data-image-key=\"Stage_Cathedral_icon.png\" data-relevant=\"0\" data-src=\"https://static.wikia.nocookie.net/bindingofisaacre_gamepedia/images/e/e3/Stage_Cathedral_icon.png/revision/latest?cb=20210826072841\" /></a></span><br /><span typeof=\"mw:File\"><a href=\"/wiki/Chest_(Floor)\" title=\"Chest\"><img alt=\"Chest\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"50\" height=\"35\" class=\"mw-file-element lazyload\" data-image-name=\"Stage Chest icon.png\" data-image-key=\"Stage_Chest_icon.png\" data-relevant=\"0\" data-src=\"https://static.wikia.nocookie.net/bindingofisaacre_gamepedia/images/2/25/Stage_Chest_icon.png/revision/latest?cb=20210825114034\" /></a></span><br /><span typeof=\"mw:File\"><a href=\"/wiki/Greed_Mode#Ultra_Greed\" title=\"Ultra Greed\"><img alt=\"Ultra Greed\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"50\" height=\"42\" class=\"mw-file-element lazyload\" data-image-name=\"Stage Ultra Greed icon.png\" data-image-key=\"Stage_Ultra_Greed_icon.png\" data-relevant=\"0\" data-src=\"https://static.wikia.nocookie.net/bindingofisaacre_gamepedia/images/7/7f/Stage_Ultra_Greed_icon.png/revision/latest?cb=20210825062836\" /></a></span><br /><span typeof=\"mw:File\"><a href=\"/wiki/Challenge_Room\" title=\"Challenge Room\"><img alt=\"Challenge Room Icon\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"27\" height=\"24\" class=\"mw-file-element lazyload\" data-image-name=\"Challenge Room Icon.png\" data-image-key=\"Challenge_Room_Icon.png\" data-relevant=\"0\" data-src=\"https://static.wikia.nocookie.net/bindingofisaacre_gamepedia/images/1/1b/Challenge_Room_Icon.png/revision/latest?cb=20210821102142\" /></a></span><span typeof=\"mw:File\"><a href=\"/wiki/Shop\" title=\"Shop\"><img alt=\"Shop Icon\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"27\" height=\"24\" class=\"mw-file-element lazyload\" data-image-name=\"Shop Icon.png\" data-image-key=\"Shop_Icon.png\" data-relevant=\"0\" data-src=\"https://static.wikia.nocookie.net/bindingofisaacre_gamepedia/images/7/76/Shop_Icon.png/revision/latest?cb=20210825033505\" /></a></span></div>\n</div>\n</aside>\n <p class=\"mw-empty-elt\"></p><div class=\"disambig-notice\">This article is about the monster.&#32;For the playable character, see <a href=\"/wiki/Keeper\" title=\"Keeper\">Keeper</a>.</div>\n<p><b>Keepers</b> (also known as \"Greed Heads\") are bodiless &#32;<span class=\"inline-icon\" typeof=\"mw:File\"><a href=\"/wiki/Hanger\" title=\"Hanger\"><img alt=\"Hanger\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"9\" height=\"20\" class=\"mw-file-element lazyload\" data-image-name=\"Hanger.png\" data-image-key=\"Hanger.png\" data-relevant=\"0\" data-src=\"https://static.wikia.nocookie.net/bindingofisaacre_gamepedia/images/b/b1/Hanger.png/revision/latest/scale-to-width-down/9?cb=20210821092955\" /></a></span><a href=\"/wiki/Hanger\" title=\"Hanger\">Hangers</a>, commonly found in <span class=\"inline-icon\" typeof=\"mw:File\"><a href=\"/wiki/Catacombs\" title=\"Catacombs\"><img alt=\"Catacombs\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"20\" height=\"14\" class=\"mw-file-element lazyload\" data-image-name=\"Stage Catacombs icon.png\" data-image-key=\"Stage_Catacombs_icon.png\" data-relevant=\"0\" data-src=\"https://static.wikia.nocookie.net/bindingofisaacre_gamepedia/images/2/23/Stage_Catacombs_icon.png/revision/latest/scale-to-width-down/20?cb=20210826072821\" /></a></span><a href=\"/wiki/Catacombs\" title=\"Catacombs\">Catacombs</a> and the <span class=\"mw-default-size dlc dlc-14\" typeof=\"mw:File\"><span title=\"Added in Afterbirth\"><img alt=\"(except in Rebirth)\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"31\" height=\"14\" class=\"mw-file-element lazyload\" data-image-name=\"Dlc a indicator.png\" data-image-key=\"Dlc_a_indicator.png\" data-relevant=\"0\" data-src=\"https://static.wikia.nocookie.net/bindingofisaacre_gamepedia/images/9/95/Dlc_a_indicator.png/revision/latest?cb=20220122155526\" /></span></span> <span class=\"inline-icon\" typeof=\"mw:File\"><a href=\"/wiki/Dank_Depths\" title=\"Dank Depths\"><img alt=\"Dank Depths\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"20\" height=\"14\" class=\"mw-file-element lazyload\" data-image-name=\"Stage Dank Depths icon.png\" data-image-key=\"Stage_Dank_Depths_icon.png\" data-relevant=\"0\" data-src=\"https://static.wikia.nocookie.net/bindingofisaacre_gamepedia/images/0/04/Stage_Dank_Depths_icon.png/revision/latest/scale-to-width-down/20?cb=20210826073222\" /></a></span><a href=\"/wiki/Dank_Depths\" title=\"Dank Depths\">Dank Depths</a>. They can also be spawned by &#32;<span class=\"inline-icon\" typeof=\"mw:File\"><a href=\"/wiki/Super_Greed\" title=\"Super Greed\"><img alt=\"Super Greed\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"17\" height=\"20\" class=\"mw-file-element lazyload\" data-image-name=\"Super Greed.png\" data-image-key=\"Super_Greed.png\" data-relevant=\"0\" data-src=\"https://static.wikia.nocookie.net/bindingofisaacre_gamepedia/images/2/20/Super_Greed.png/revision/latest/scale-to-width-down/17?cb=20210825032614\" /></a></span><a href=\"/wiki/Super_Greed\" title=\"Super Greed\">Super Greed</a> and <span class=\"mw-default-size dlc dlc-14\" typeof=\"mw:File\"><span title=\"Added in Afterbirth\"><img alt=\"(except in Rebirth)\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"31\" height=\"14\" class=\"mw-file-element lazyload\" data-image-name=\"Dlc a indicator.png\" data-image-key=\"Dlc_a_indicator.png\" data-relevant=\"0\" data-src=\"https://static.wikia.nocookie.net/bindingofisaacre_gamepedia/images/9/95/Dlc_a_indicator.png/revision/latest?cb=20220122155526\" /></span></span> &#32;<span class=\"inline-icon\" typeof=\"mw:File\"><a href=\"/wiki/Ultra_Greed\" title=\"Ultra Greed\"><img alt=\"Boss Ultra Greed ingame\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"20\" height=\"20\" class=\"mw-file-element lazyload\" data-image-name=\"Boss Ultra Greed ingame.png\" data-image-key=\"Boss_Ultra_Greed_ingame.png\" data-relevant=\"0\" data-src=\"https://static.wikia.nocookie.net/bindingofisaacre_gamepedia/images/8/8f/Boss_Ultra_Greed_ingame.png/revision/latest/scale-to-width-down/20?cb=20210822103557\" /></a></span><a href=\"/wiki/Ultra_Greed\" title=\"Ultra Greed\">Ultra Greed</a>, or found alongside Hangers. They move like &#32;<span class=\"inline-icon\" typeof=\"mw:File\"><a href=\"/wiki/Hopper\" title=\"Hopper\"><img alt=\"Hopper\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"20\" height=\"17\" class=\"mw-file-element lazyload\" data-image-name=\"Hopper.png\" data-image-key=\"Hopper.png\" data-relevant=\"0\" data-src=\"https://static.wikia.nocookie.net/bindingofisaacre_gamepedia/images/8/81/Hopper.png/revision/latest?cb=20210821090334\" /></a></span><a href=\"/wiki/Hopper\" title=\"Hopper\">Hoppers</a> and occasionally stop to shoot two projectiles in a V shape towards Isaac. If hit by these projectiles, Isaac will drop coins.\n</p>\n<p><br class=\"content-filter-end\" /></p><div class=\"nav-start\" style=\"clear: both\"></div>\n<table class=\"nav-box nav-main\">\n<tbody><tr>\n<th class=\"nav-title\"><span class=\"no-alt\" typeof=\"mw:File\"><span><img alt=\"SmallIsaac\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"30\" height=\"30\" class=\"mw-file-element lazyload\" data-image-name=\"SmallIsaac.png\" data-image-key=\"SmallIsaac.png\" data-relevant=\"0\" data-src=\"https://static.wikia.nocookie.net/bindingofisaacre_gamepedia/images/a/a6/SmallIsaac.png/revision/latest?cb=20210821194340\" /></span></span><a href=\"/wiki/Binding_of_Isaac:_Rebirth_Wiki\" title=\"Binding of Isaac: Rebirth Wiki\">The Binding of Isaac: Rebirth</a><span class=\"no-alt\" typeof=\"mw:File\"><span><img alt=\"SmallIsaac\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"30\" height=\"30\" class=\"mw-file-element lazyload\" data-image-name=\"SmallIsaac.png\" data-image-key=\"SmallIsaac.png\" data-relevant=\"0\" data-src=\"https://static.wikia.nocookie.net/bindingofisaacre_gamepedia/images/a/a6/SmallIsaac.png/revision/latest?cb=20210821194340\" /></span></span>\n</th></tr>\n<tr>\n<td>\n<ul><li><span class=\"inline-icon\" typeof=\"mw:File\"><a href=\"/wiki/Achievements\" title=\"Achievements\"><img alt=\"MainPageAchievements\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAE