{"parse": {"title": "Meatball", "pageid": 10809, "revid": 310321, "redirects": [], "text": "<div class=\"mw-content-ltr mw-parser-output\" lang=\"en\" dir=\"ltr\"><p class=\"mw-empty-elt\">\n</p><aside role=\"region\" class=\"portable-infobox pi-background pi-border-color pi-theme-wikia pi-layout-stacked\">\n<h2 class=\"pi-item pi-item-spacing pi-title pi-secondary-background\" data-source=\"name\"><div class=\"infobox2-slideshow dlc-slideshow\"><div class=\"infobox2-slide\"><span style=\"white-space:nowrap\"><span typeof=\"mw:File\"><span><img alt=\"M\" src=\"https://static.wikia.nocookie.net/bindingofisaacre_gamepedia/images/0/06/Font_TeamMeat_M.png/revision/latest?cb=20210822055712\" decoding=\"async\" loading=\"lazy\" width=\"28\" height=\"26\" class=\"mw-file-element\" data-image-name=\"Font TeamMeat M.png\" data-image-key=\"Font_TeamMeat_M.png\" data-relevant=\"0\" /></span></span><span typeof=\"mw:File\"><span><img alt=\"e\" src=\"https://static.wikia.nocookie.net/bindingofisaacre_gamepedia/images/8/8a/Font_TeamMeat_e.png/revision/latest?cb=20210822060501\" decoding=\"async\" loading=\"lazy\" width=\"18\" height=\"15\" class=\"mw-file-element\" data-image-name=\"Font TeamMeat e.png\" data-image-key=\"Font_TeamMeat_e.png\" data-relevant=\"0\" /></span></span><span typeof=\"mw:File\"><span><img alt=\"a\" src=\"https://static.wikia.nocookie.net/bindingofisaacre_gamepedia/images/3/30/Font_TeamMeat_a.png/revision/latest?cb=20210822060324\" decoding=\"async\" loading=\"lazy\" width=\"17\" height=\"15\" class=\"mw-file-element\" data-image-name=\"Font TeamMeat a.png\" data-image-key=\"Font_TeamMeat_a.png\" data-relevant=\"0\" /></span></span><span typeof=\"mw:File\"><span><img alt=\"t\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"20\" height=\"13\" class=\"mw-file-element lazyload\" data-image-name=\"Font TeamMeat t.png\" data-image-key=\"Font_TeamMeat_t.png\" data-relevan