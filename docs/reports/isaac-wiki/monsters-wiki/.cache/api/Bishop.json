"0\" data-src=\"https://static.wikia.nocookie.net/bindingofisaacre_gamepedia/images/1/11/Font_TeamMeat_h.png/revision/latest?cb=20210822060613\" /></span></span><span typeof=\"mw:File\"><span><img alt=\"o\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"20\" height=\"15\" class=\"mw-file-element lazyload\" data-image-name=\"Font TeamMeat o.png\" data-image-key=\"Font_TeamMeat_o.png\" data-relevant=\"0\" data-src=\"https://static.wikia.nocookie.net/bindingofisaacre_gamepedia/images/e/e3/Font_TeamMeat_o.png/revision/latest?cb=20210822060902\" /></span></span><span typeof=\"mw:File\"><span><img alt=\"p\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"17\" height=\"14\" class=\"mw-file-element lazyload\" data-image-name=\"Font TeamMeat p.png\" data-image-key=\"Font_TeamMeat_p.png\" data-relevant=\"0\" data-src=\"https://static.wikia.nocookie.net/bindingofisaacre_gamepedia/images/2/2f/Font_TeamMeat_p.png/revision/latest?cb=20210822060927\" /></span></span></span></div></div></h2>\n\n<div class=\"pi-item pi-data pi-item-spacing pi-border-color\" data-source=\"image\">\n\t\n\t\t<h3 class=\"pi-data-label pi-secondary-font\">Entity Image</h3>\n\t\n\t<div class=\"pi-data-value pi-font\"><div class=\"infobox2-slideshow dlc-slideshow\"><div class=\"infobox2-slide\"><span typeof=\"mw:File\"><span title=\"Entity image\"><img alt=\"Entity image\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"90\" height=\"150\" class=\"mw-file-element lazyload\" data-image-name=\"Bishop.png\" data-image-key=\"Bishop.png\" data-relevant=\"0\" data-src=\"https://static.wikia.nocookie.net/bindingofisaacre_gamepedia/images/f/f0/Bishop.png/revision/latest?cb=20210824103140\" /></span></span></div></div><br /></div>\n</div>\n<section class=\"pi-item pi-group pi-border-color\">\n\t<section class=\"pi-item pi-smart-group pi-border-color\">\n    \n        <section class=\"pi-smart-group-head pi-border-color\">\n            \n                <h3 class=\"pi-smart-data-label pi-data-label pi-secondary-font pi-item-spacing pi-border-color\" style=\"width: calc(1 / 2 * 100%);\" data-source=\"base hp\">Base HP</h3>\n            \n                <h3 class=\"pi-smart-data-label pi-data-label pi-secondary-font pi-item-spacing pi-border-color\" style=\"width: calc(1 / 2 * 100%);\" data-source=\"stage hp\">Stage HP</h3>\n            \n        </section>\n    \n    <section class=\"pi-smart-group-body pi-border-color\">\n        \n            <div class=\"pi-smart-data-value pi-data-value pi-font pi-item-spacing pi-border-color\" style=\"width: calc(1 / 2 * 100%);\" data-source=\"base hp\"><div class=\"infobox2-slideshow dlc-slideshow\"><div class=\"infobox2-slide\"> <span class=\"pi-custom-font\">14</span></div></div></div>\n        \n            <div class=\"pi-smart-data-value pi-data-value pi-font pi-item-spacing pi-border-color\" style=\"width: calc(1 / 2 * 100%);\" data-source=\"stage hp\"><div class=\"infobox2-slideshow dlc-slideshow\"><div class=\"infobox2-slide\"> <span class=\"pi-custom-font\">4</span></div></div></div>\n        \n    </section>\n</section>\n\n</section>\n\n<div class=\"pi-item pi-data pi-item-spacing pi-border-color\" data-source=\"id\">\n\t\n\t\t<h3 class=\"pi-data-label pi-secondary-font\">Entity ID</h3>\n\t\n\t<div class=\"pi-data-value pi-font\"><code>805.0</code></div>\n</div>\n\n<div class=\"pi-item pi-data pi-item-spacing pi-border-color\" data-source=\"environment\">\n\t\n\t\t<h3 class=\"pi-data-label pi-secondary-font\">Found In</h3>\n\t\n\t<div class=\"pi-data-value pi-font\"><span typeof=\"mw:File\"><a href=\"/wiki/Mausoleum\" title=\"Mausoleum\"><img alt=\"Stage Mausoleum icon\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"50\" height=\"35\" class=\"mw-file-element lazyload\" data-image-name=\"Stage Mausoleum icon.png\" data-image-key=\"Stage_Mausoleum_icon.png\" data-relevant=\"0\" data-src=\"https://static.wikia.nocookie.net/bindingofisaacre_gamepedia/images/8/80/Stage_Mausoleum_icon.png/revision/latest?cb=20210825172400\" /></a></span><br /><span typeof=\"mw:File\"><a href=\"/wiki/Cathedral\" title=\"Cathedral\"><img alt=\"Stage Cathedral icon\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"50\" height=\"35\" class=\"mw-file-element lazyload\" data-image-name=\"Stage Cathedral icon.png\" data-image-key=\"Stage_Cathedral_icon.png\" data-relevant=\"0\" data-src=\"https://static.wikia.nocookie.net/bindingofisaacre_gamepedia/images/e/e3/Stage_Cathedral_icon.png/revision/latest?cb=20210826072841\" /></a></span><br /><span typeof=\"mw:File\"><a href=\"/wiki/Challenge_Room\" title=\"Challenge Room\"><img alt=\"Challenge Room Icon\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"27\" height=\"24\" class=\"mw-file-element lazyload\" data-image-name=\"Challenge Room Icon.png\" data-image-key=\"Challenge_Room_Icon.png\" data-relevant=\"0\" data-src=\"https://static.wikia.nocookie.net/bindingofisaacre_gamepedia/images/1/1b/Challenge_Room_Icon.png/revision/latest?cb=20210821102142\" /></a></span></div>\n</div>\n</aside>\n<p class=\"mw-empty-elt\"></p><div id=\"context-page\" class=\"context-box\"><span class=\"mw-default-size dlc dlc-8\" typeof=\"mw:File\"><span title=\"Added in Repentance\"><img alt=\"(in Repentance)\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"31\" height=\"14\" class=\"mw-file-element lazyload\" data-image-name=\"Dlc r indicator.png\" data-image-key=\"Dlc_r_indicator.png\" data-relevant=\"0\" data-src=\"https://static.wikia.nocookie.net/bindingofisaacre_gamepedia/images/f/f2/Dlc_r_indicator.png/revision/latest?cb=20210815090252\" /></span></span> </div>\n<p><b>Bishops</b> are stationary enemies added in <i><a href=\"/wiki/The_Binding_of_Isaac:_Repentance\" title=\"The Binding of Isaac: Repentance\">The Binding of Isaac: Repentance</a></i>. They appear only in <span class=\"inline-icon\" typeof=\"mw:File\"><a href=\"/wiki/Mausoleum\" title=\"Mausoleum\"><img alt=\"Mausoleum\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"20\" height=\"14\" class=\"mw-file-element lazyload\" data-image-name=\"Stage Mausoleum icon.png\" data-image-key=\"Stage_Mausoleum_icon.png\" data-relevant=\"0\" data-src=\"https://static.wikia.nocookie.net/bindingofisaacre_gamepedia/images/8/80/Stage_Mausoleum_icon.png/revision/latest/scale-to-width-down/20?cb=20210825172400\" /></a></span><a href=\"/wiki/Mausoleum\" title=\"Mausoleum\">Mausoleum</a> and <span class=\"inline-icon\" typeof=\"mw:File\"><a href=\"/wiki/Cathedral\" title=\"Cathedral\"><img alt=\"Cathedral\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"20\" height=\"14\" class=\"mw-file-element lazyload\" data-image-name=\"Stage Cathedral icon.png\" data-image-key=\"Stage_Cathedral_icon.png\" data-relevant=\"0\" data-src=\"https://static.wikia.nocookie.net/bindingofisaacre_gamepedia/images/e/e3/Stage_Cathedral_icon.png/revision/latest/scale-to-width-down/20?cb=20210826072841\" /></a></span><a href=\"/wiki/Cathedral\" title=\"Cathedral\">Cathedral</a>.\n</p><p>While a Bishop is alive in the current room, all other enemies that aren't Bishops will be given <a href=\"/wiki/Temporary_Buffs#Effects\" title=\"Temporary Buffs\">shields</a>, protecting them from all damage taken; all Bishops in the room must be killed for the other enemies to take damage as normal. Additionally, when Bishops take damage, they retaliate by firing shots in the cardinal directions.\n</p>\n<h2><span class=\"mw-headline\" id=\"Notes\">Notes</span></h2>\n<ul><li>Bishops will not protect other enemies while <a href=\"/wiki/Status_Effects#Petrification\" title=\"Status Effects\">petrified</a>.</li>\n<li>Bishops will shield Isaac if he takes damage while they are <a href=\"/wiki/Status_Effects#Charm\" title=\"Status Effects\">charmed</a>.</li>\n<li>When captured by <span class=\"tooltip\" data-tooltip=\"i/tooltip&#124;Friendly+Ball&#124;8\"><span class=\"inline-icon\" typeof=\"mw:File\"><a href=\"/wiki/Friendly_Ball\" title=\"Friendly Ball\"><img alt=\"Collectible Friendly Ball icon\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"20\" height=\"20\" class=\"mw-file-element lazyload\" data-image-name=\"Collectible Friendly Ball icon.png\" data-image-key=\"Collectible_Friendly_Ball_icon.png\" data-relevant=\"0\" data-src=\"https://static.wikia.nocookie.net/bindingofisaacre_gamepedia/images/f/f1/Collectible_Friendly_Ball_icon.png/revision/latest/scale-to-width-down/20?cb=20210821162131\" /></a></span><a href=\"/wiki/Friendly_Ball\" title=\"Friendly Ball\">Friendly Ball</a></span>, the Bishop will shield Isaac, but unlike with enemies, blocking damage done to Isaac damages the Bishop.</li>\n<li>Bishops cannot be healed by <a href=\"/wiki/Monsters#Champions\" title=\"Monsters\">Pulsing Vivid Red Champions</a>.</li></ul>\n<h2><span class=\"mw-headline\" id=\"Gallery\">Gallery</span></h2>\n<ul class=\"gallery mw-gallery-traditional\">\n\t\t<li class=\"gallerybox\" style=\"width: 155px\">\n\t\t\t<div class=\"thumb\" style=\"width: 150px; height: 150px;\"><span typeof=\"mw:File\"><a href=\"https://static.wikia.nocookie.net/bindingofisaacre_gamepedia/images/a/ad/Bishop_old.png/revision/latest?cb=20210824142844\" class=\"mw-file-description image\" title=\"Bishops in Antibirth.\"><img alt=\"Bishops in Antibirth.\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"72\" height=\"120\" class=\"mw-file-element lazyload\" data-image-name=\"Bishop old.png\" data-image-key=\"Bishop_old.png\" data-relevant=\"0\" data-src=\"https://static.wikia.nocookie.net/bindingofisaacre_gamepedia/images/a/ad/Bishop_old.png/revision/latest?cb=20210824142844\" /></a></span></div>\n\t\t\t<div class=\"gallerytext\"> Bishops in <i>Antibirth.</i></div>\n\t\t</li>\n\t\t<li class=\"gallerybox\" style=\"width: 155px\">\n\t\t\t<div class=\"thumb\" style=\"width: 150px; height: 150px;\"><span typeof=\"mw:File\"><a href=\"https://static.wikia.nocookie.net/bindingofisaacre_gamepedia/images/9/93/Bishop_Concept.png/revision/latest?cb=20230111010336\" class=\"mw-file-description image\" title=\"Concept art of the Bishop for Antibirth along with another unused monster concept art.\"><img alt=\"Concept art of the Bishop for Antibirth along with another unused monster concept art.\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"120\" height=\"68\" class=\"mw-file-element lazyload\" data-image-name=\"Bishop Concept.png\" data-image-key=\"Bishop_Concept.png\" data-relevant=\"1\" data-src=\"https://static.wikia.nocookie.net/bindingofisaacre_gamepedia/images/9/93/Bishop_Concept.png/revision/latest/scale-to-width-down/120?cb=20230111010336\" /></a></span></div>\n\t\t\t<div class=\"gallerytext\">Concept art of the Bishop for Antibirth along with another unused monster concept art.</div>\n\t\t</li>\n</ul>\n<h2><span class=\"mw-headline\" id=\"Trivia\">Trivia</span></h2>\n<ul><li>In <i>Antibirth</i>, <a href=\"https://antibirth.fandom.com/wiki/Bishop\" class=\"extiw\" title=\"anti:Bishop\">Bishop</a>'s robes had a purple color, didn't shoot tears after taking damage, had a base hp of 5, and could appear in <span class=\"inline-icon\" typeof=\"mw:File\"><a href=\"/wiki/Chest_(Floor)\" title=\"Chest\"><img alt=\"Chest\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"20\" height=\"14\" class=\"mw-file-element lazyload\" data-image-name=\"Stage Chest icon.png\" data-image-key=\"Stage_Chest_icon.png\" data-relevant=\"0\" data-src=\"https://static.wikia.nocookie.net/bindingofisaacre_gamepedia/images/2/25/Stage_Chest_icon.png/revision/latest/scale-to-width-down/20?cb=20210825114034\" /></a></span><a href=\"/wiki/Chest_(Floor)\" title=\"Chest (Floor)\">Chest</a>.</li></ul>\n<p><br class=\"content-filter-end\" /></p><div class=\"nav-start\" style=\"clear: both\"></div>\n<table class=\"nav-box nav-main\">\n<tbody><tr>\n<th class=\"nav-title\"><span class=\"no-alt\" typeof=\"mw:File\"><span><img alt=\"SmallIsaac\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"30\" height=\"30\" class=\"mw-file-element lazyload\" data-image-name=\"SmallIsaac.png\" data-image-key=\"SmallIsaac.png\" data-relevant=\"0\" data-src=\"https://static.wikia.nocookie.net/bindingofisaacre_gamepedia/images/a/a6/SmallIsaac.png/revision/latest?cb=20210821194340\" /></span></span><a href=\"/wiki/Binding_of_Isaac:_Rebirth_Wiki\" title=\"Binding of Isaac: Rebirth Wiki\">The Binding of Isaac: Rebirth</a><span class=\"no-alt\" typeof=\"mw:File\"><span><img alt=\"SmallIsaac\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"30\" height=\"30\" class=\"mw-file-element lazyload\" data-image-name=\"SmallIsaac.png\" data-image-key=\"SmallIsaac.png\" data-relevant=\"0\" data-src=\"https://static.wikia.nocookie.net/bindingofisaacre_gamepedia/images/a/a6/SmallIsaac.png/revision/latest?cb=20