{"parse": {"title": "Exorcist", "pageid": 25771, "revid": 310248, "redirects": [], "text": "<div class=\"mw-content-ltr mw-parser-output\" lang=\"en\" dir=\"ltr\"><p class=\"mw-empty-elt\">\n</p><aside role=\"region\" class=\"portable-infobox pi-background pi-border-color pi-theme-wikia pi-layout-stacked\">\n<h2 class=\"pi-item pi-item-spacing pi-title pi-secondary-background\" data-source=\"name\"><div class=\"infobox2-slideshow dlc-slideshow\"><div class=\"infobox2-slide\"><span style=\"white-space:nowrap\"><span typeof=\"mw:File\"><span><img alt=\"E\" src=\"https://static.wikia.nocookie.net/bindingofisaacre_gamepedia/images/7/76/Font_TeamMeat_E.png/revision/latest?cb=20210822055403\" decoding=\"async\" loading=\"lazy\" width=\"20\" height=\"27\" class=\"mw-file-element\" data-image-name=\"Font TeamMeat E.png\" data-image-key=\"Font_TeamMeat_E.png\" data-relevant=\"0\" /></span></span><span typeof=\"mw:File\"><span><img alt=\"x\" src=\"https://static.wikia.nocookie.net/bindingofisaacre_gamepedia/images/3/3a/Font_TeamMeat_x.png/revision/latest?cb=20210822061241\" decoding=\"async\" loading=\"lazy\" width=\"17\" height=\"15\" class=\"mw-file-element\" data-image-name=\"Font TeamMeat x.png\" data-image-key=\"Font_TeamMeat_x.png\" data-relevant=\"0\" /></span></span><span typeof=\"mw:File\"><span><img alt=\"o\" src=\"https://static.wikia.nocookie.net/bindingofisaacre_gamepedia/images/e/e3/Font_TeamMeat_o.png/revision/latest?cb=20210822060902\" decoding=\"async\" loading=\"lazy\" width=\"20\" height=\"15\" class=\"mw-file-element\" data-image-name=\"Font TeamMeat o.png\" data-image-key=\"Font_TeamMeat_o.png\" data-relevant=\"0\" /></span></span><span typeof=\"mw:File\"><span><img alt=\"r\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"18\" height=\"13\" class=\"mw-file-element lazyload\" data-image-name=\"Font TeamMeat r.png\" data-image-key=\"Font_TeamMeat_r.png\" data-relevant=\"0\" data-src=\"https://static.wikia.nocookie.net/bindingofisaacre_gamepedia/images/1/1e/Font_TeamMeat_r.png/revision/latest?cb=20210822061013\" /></span></span><span typeof=\"mw:File\"><span><img alt=\"c\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"18\" height=\"16\" class=\"mw-file-element lazyload\" data-image-name=\"Font TeamMeat c.png\" data-image-key=\"Font_TeamMeat_c.png\" data-relevant=\"0\" data-src=\"https://static.wikia.nocookie.net/bindingofisaacre_gamepedia/images/4/45/Font_TeamMeat_c.png/revision/latest?cb=20210822060413\" /></span></span><span typeof=\"mw:File\"><span><img alt=\"i\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"8\" height=\"14\" class=\"mw-file-element lazyload\" data-image-name=\"Font TeamMeat i.png\" data-image-key=\"Font_TeamMeat_i.png\" data-relevant=\"0\" data-src=\"https://static.wikia.nocookie.net/bindingofisaacre_gamepedia/images/b/b0/Font_TeamMeat_i.png/revision/latest?cb=20210822060636\" /></span></span><span typeof=\"mw:File\"><span><img alt=\"s\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"18\" height=\"13\" class=\"mw-file-element lazyload\" data-image-name=\"Font TeamMeat s.png\" data-image-key=\"Font_TeamMeat_s.png\" data-relevant=\"0\" data-src=\"https://static.wikia.nocookie.net/bindingofisaacre_gamepedia/images/2/2e/Font_TeamMeat_s.png/revision/latest?cb=20210822061039\" /></span></span><span typeof=\"mw:File\"><span><img alt=\"t\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"20\" height=\"13\" class=\"mw-file-element lazyload\" data-image-name=\"Font TeamMeat t.png\" data-image-key=\"Font_TeamMeat_t.png\" data-relevant=\"0\" data-src=\"https://static.wikia.nocookie.net/bindingofisaacre_gamepedia/images/b/b0/Font_TeamMeat_t.png/revision/latest?cb=20210822061104\" /></span></span></span></div></div></h2>\n\n<div class=\"pi-item pi-data pi-item-spacing pi-border-color\" data-source=\"image\">\n\t\n\t\t<h3 class=\"pi-data-label pi-secondary-font\">Entity Image</h3>\n\t\n\t<div class=\"pi-data-value pi-font\"><div class=\"infobox2-slideshow dlc-slideshow\"><div class=\"infobox2-slide\"><span typeof=\"mw:File\"><span title=\"Entity image\"><img alt=\"Entity image\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"90\" height=\"99\" class=\"mw-file-element lazyload\" data-image-name=\"Exorcist.png\" data-image-key=\"Exorcist.png\" data-relevant=\"0\" data-src=\"https://static.wikia.nocookie.net/bindingofisaacre_gamepedia/images/a/ac/Exorcist.png/revision/latest?cb=20210824124216\" /></span></span></div></div><br /></div>\n</div>\n<section class=\"pi-item pi-group pi-border-color\">\n\t<section class=\"pi-item pi-smart-group pi-border-color\">\n    \n        <section class=\"pi-smart-group-head pi-border-color\">\n            \n                <h3 class=\"pi-smart-data-label pi-data-label pi-secondary-font pi-item-spacing pi-border-color\" style=\"width: calc(1 / 2 * 100%);\" data-source=\"base hp\">Base HP</h3>\n            \n                <h3 class=\"pi-smart-data-label pi-data-label pi-secondary-font pi-item-spacing pi-border-color\" style=\"width: calc(1 / 2 * 100%);\" data-source=\"stage hp\">Stage HP</h3>\n            \n        </section>\n    \n    <section class=\"pi-smart-group-body pi-border-color\">\n        \n            <div class=\"pi-smart-data-value pi-data-value pi-font pi-item-spacing pi-border-color\" style=\"width: calc(1 / 2 * 100%);\" data-source=\"base hp\"><div class=\"infobox2-slideshow dlc-slideshow\"><div class=\"infobox2-slide\"> <span class=\"pi-custom-font\">25</span></div></div></div>\n        \n            <div class=\"pi-smart-data-value pi-data-value pi-font pi-item-spacing pi-border-color\" style=\"width: calc(1 / 2 * 100%);\" data-source=\"stage hp\"><div class=\"infobox2-slideshow dlc-slideshow\"><div class=\"infobox2-slide\"> <span class=\"pi-custom-font\">0</span></div></div></div>\n        \n    </section>\n</section>\n\n</section>\n\n<div class=\"pi-item pi-data pi-item-spacing pi-border-color\" data-source=\"id\">\n\t\n\t\t<h3 class=\"pi-data-label pi-secondary-font\">Entity ID</h3>\n\t\n\t<div class=\"pi-data-value pi-font\"><code>832.0</code></div>\n</div>\n\n<div class=\"pi-item pi-data pi-item-spacing pi-border-color\" data-source=\"environment\">\n\t\n\t\t<h3 class=\"pi-data-label pi-secondary-font\">Found In</h3>\n\t\n\t<div class=\"pi-data-value pi-font\"><span typeof=\"mw:File\"><a href=\"/wiki/Mausoleum\" title=\"Mausoleum\"><img alt=\"Stage Mausoleum icon\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"50\" height=\"35\" class=\"mw-file-element lazyload\" data-image-name=\"Stage Mausoleum icon.png\" data-image-key=\"Stage_Mausoleum_icon.png\" data-relevant=\"0\" data-src=\"https://static.wikia.nocookie.net/bindingofisaacre_gamepedia/images/8/80/Stage_Mausoleum_icon.png/revision/latest?cb=20210825172400\" /></a></span><br />During the fight with &#32;<span class=\"inline-icon\" typeof=\"mw:File\"><a href=\"/wiki/The_Heretic\" title=\"The Heretic\"><img alt=\"Boss The Heretic ingame\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"20\" height=\"19\" class=\"mw-file-element lazyload\" data-image-name=\"Boss The Heretic ingame.png\" data-image-key=\"Boss_The_Heretic_ingame.png\" data-relevant=\"0\" data-src=\"https://static.wikia.nocookie.net/bindingofisaacre_gamepedia/images/b/b5/Boss_The_Heretic_ingame.png/revision/latest/scale-to-width-down/20?cb=20210824124036\" /></a></span><a href=\"/wiki/The_Heretic\" title=\"The Heretic\">The Heretic</a></div>\n</div>\n</aside>\n<p class=\"mw-empty-elt\"></p><div id=\"context-page\" class=\"context-box\"><span class=\"mw-default-size dlc dlc-8\" typeof=\"mw:File\"><span title=\"Added in Repentance\"><img alt=\"(in Repentance)\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"31\" height=\"14\" class=\"mw-file-element lazyload\" data-image-name=\"Dlc r indicator.png\" data-image-key=\"Dlc_r_indicator.png\" data-relevant=\"0\" data-src=\"https://static.wikia.nocookie.net/bindingofisaacre_gamepedia/images/f/f2/Dlc_r_indicator.png/revision/latest?cb=20210815090252\" /></span></span> </div>\n<p><b>Exorcists</b> are enemies found exclusively in the fight against &#32;<span class=\"inline-icon\" typeof=\"mw:File\"><a href=\"/wiki/The_Heretic\" title=\"The Heretic\"><img alt=\"Boss The Heretic ingame\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"20\" height=\"19\" class=\"mw-file-element lazyload\" data-image-name=\"Boss The Heretic ingame.png\" data-image-key=\"Boss_The_Heretic_ingame.png\" data-relevant=\"0\" data-src=\"https://static.wikia.nocookie.net/bindingofisaacre_gamepedia/images/b/b5/Boss_The_Heretic_ingame.png/revision/latest/scale-to-width-down/20?cb=20210824124036\" /></a></span><a href=\"/wiki/The_Heretic\" title=\"The Heretic\">The Heretic</a>, and can never be found naturally. They take the appearance of a &#32;<span class=\"inline-icon\" typeof=\"mw:File\"><a href=\"/wiki/Gaper\" title=\"Gaper\"><img alt=\"Gaper\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"17\" height=\"20\" class=\"mw-file-element lazyload\" data-image-name=\"Gaper.png\" data-image-key=\"Gaper.png\" data-relevant=\"0\" data-src=\"https://static.wikia.nocookie.net/bindingofisaacre_gamepedia/images/3/3b/Gaper.png/revision/latest/scale-to-width-down/17?cb=20210821090455\" /></a></span><a href=\"/wiki/Gaper\" title=\"Gaper\">Gaper</a> with its head's skin rolled down, revealing its skull.\n</p><p>If spawned by itself, it will start to walk towards Isaac, occasionally spawning a single &#32;<span class=\"inline-icon\" typeof=\"mw:File\"><a href=\"/wiki/Lil%27_Haunt\" title=\"Lil&#39; Haunt\"><img alt=\"Lil&#39; Haunt\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"20\" height=\"17\" class=\"mw-file-element lazyload\" data-image-name=\"Lil&#39; Haunt.png\" data-image-key=\"Lil%27_Haunt.png\" data-relevant=\"0\" data-src=\"https://static.wikia.nocookie.net/bindingofisaacre_gamepedia/images/0/0f/Lil%27_Haunt.png/revision/latest/scale-to-width-down/20?cb=20210821092837\" /></a></span><a href=\"/wiki/Lil%27_Haunt\" title=\"Lil&#39; Haunt\">Lil' Haunt</a>. It will try to follow the most recently spawned &#32;<span class=\"inline-icon\" typeof=\"mw:File\"><a href=\"/wiki/Lil%27_Haunt\" title=\"Lil&#39; Haunt\"><img alt=\"Lil&#39; Haunt\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"20\" height=\"17\" class=\"mw-file-element lazyload\" data-image-name=\"Lil&#39; Haunt.png\" data-image-key=\"Lil%27_Haunt.png\" data-relevant=\"0\" data-src=\"https://static.wikia.nocookie.net/bindingofisaacre_gamepedia/images/0/0f/Lil%27_Haunt.png/revision/latest/scale-to-width-down/20?cb=20210821092837\" /></a></span><a href=\"/wiki/Lil%27_Haunt\" title=\"Lil&#39; Haunt\">Lil' Haunt</a> and use it to shield itself, and it will only spawn another Lil' Haunt once the previous one has been killed. It will also run away from Isaac once its designated Lil Haunt has been killed prior to spawning another.\n</p><p>After an enemy dies, it will leave behind a small red spirit, sometimes, an Exorcist will walk over to one of the red spirits and revive it as a &#32;<span class=\"inline-icon\" typeof=\"mw:File\"><a href=\"/wiki/Lil%27_Haunt\" title=\"Lil&#39; Haunt\"><img alt=\"Lil&#39; Haunt\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"20\" height=\"17\" class=\"mw-file-element lazyload\" data-image-name=\"Lil&#39; Haunt.png\" data-image-key=\"Lil%27_Haunt.png\" data-relevant=\"0\" data-src=\"https://static.wikia.nocookie.net/bindingofisaacre_gamepedia/images/0/0f/Lil%27_Haunt.png/revision/latest/scale-to-width-down/20?cb=20210821092837\" /></a></span><a href=\"/wiki/Lil%27_Haunt\" title=\"Lil&#39; Haunt\">Lil' Haunt</a>, similar to &#32;<span class=\"inline-icon\" typeof=\"mw:File\"><a href=\"/wiki/Rag_Man\" title=\"Rag Man\"><img alt=\"Boss Rag Man ingame\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"17\" height=\"20\" class=\"mw-file-element lazyload\" data-image-name=\"Boss Rag Man ingame.png\" data-image-key=\"Boss_Rag_Man_ingame.png\" data-relevant=\"0\" data-src=\"https://static.wikia.nocookie.net/bindingofisaacre_gamepedia/images/7/71/Boss_Rag_Man_ingame.png/revision/latest/scale-to-width-down/17?cb=20210822101429\" /></a></span><a href=\"/wiki/Rag_Man\" title=\"Rag Man\">Rag Man</a> or a &#32;<span class=\"inline-icon\" typeof=\"mw:File\"><a href=\"/wiki/Cultist\" title=\"Cultist\"><img alt=\"Cultist\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"15\" height=\"20\" class=\"mw-file-element lazyload\" data-image-name=\"Cultist.png\" data-image-key=\"Cultist.png\" data-relevant=\"0\" data-src=\"https://static.wikia.nocookie.net/bindingofisaacre_gamepedia/images/b/bd/Cultist.png/revision/latest/scale-to-width-down/15?cb=20210407200407\" /></a></span><a href=\"/wiki/Cultist\" title=\"Cultist\">Cultist</a>. These red spirits are the same ones created by <span class=\"tooltip\" data-tooltip=\"i/tooltip&#124;Vade+Retro&#124;8\"><span class=\"inline-icon\" typeof=\"mw:File\"><a href=\"/wiki/Vade_Retro\" title=\"Vade Retro\"><img alt=\"Collectible Vade Retro icon\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"20\" height=\"20\" class=\"mw-file-element lazyload\" data-image-name=\"Collectible Vade Retro icon.png\" data-image-key=\"Collectible_Vade_Retro_icon.png\" data-relevant=\"0\" data-src=\"https://static.wikia.nocookie.net/bindingofisaacre_gamepedia/images/1/1b/Collectible_Vade_Retro_icon.png/revision/latest/scale-to-width-down/20?cb=20210822151244\" /></a></span><a href=\"/wiki/Vade_Retro\" title=\"Vade Retro\">Vade Retro</a></span> and can be blown up as such. All red spirits will disappear once an exorcist dies unless holding <span class=\"tooltip\" data-tooltip=\"i/tooltip&#124;Vade+Retro&#124;8\"><span class=\"inline-icon\" typeof=\"mw:File\"><a href=\"/wiki/Vade_Retro\" title=\"Vade Retro\"><img alt=\"Collectible Vade Retro icon\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"20\" height=\"20\" class=\"mw-file-element lazyload\" data-image-name=\"Collectible Vade Retro icon.png\" data-image-key=\"Collectible_Vade_Retro_icon.png\" data-relevant=\"0\" data-src=\"https://static.wikia.nocookie.net/bindingofisaacre_gamepedia/images/1/1b/Collectible_Vade_Retro_icon.png/revision/latest/scale-to-width-down/20?cb=20210822151244\" /></a></span><a href=\"/wiki/Vade_Retro\" title=\"Vade Retro\">Vade Retro</a></span>.\n</p>\n\n<h3><span class=\"mw-headline\" id=\"Notes\">Notes</span></h3>\n<ul><li>The only method to kill the shielded Exorcists in The Heretic's fight is with <span class=\"tooltip\" data-tooltip=\"p/tooltip&#124;Chaos+Card&#124;8\"><span class=\"inline-icon\" typeof=\"mw:File\"><a href=\"/wiki/Chaos_Card\" title=\"Chaos Card\"><img alt=\"Chaos Card\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"12\" height=\"16\" class=\"mw-file-element lazyload\" data-image-name=\"Pickup Chaos Card icon.png\" data-image-key=\"Pickup_Chaos_Card_icon.png\" data-relevant=\"0\" data-src=\"https://static.wikia.nocookie.net/bindingofisaacre_gamepedia/images/4/4c/Pickup_Chaos_Card_icon.png/revision/latest/scale-to-width-down/12?cb=20141118232148\" /></a></span><a href=\"/wiki/Chaos_Card#Chaos_Card\" title=\"Chaos Card\">Chaos Card</a></span>, <span class=\"tooltip\" data-tooltip=\"i/tooltip&#124;Little+Horn&#124;8\"><span class=\"inline-icon\" typeof=\"mw:File\"><a href=\"/wiki/Little_Horn_(Item)\" title=\"Little Horn (Item)\"><img alt=\"Collectible Little Horn icon\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"20\" height=\"20\" class=\"mw-file-element lazyload\" data-image-name=\"Collectible Little Horn icon.png\" data-image-key=\"Collectible_Little_Horn_icon.png\" data-relevant=\"0\" data-src=\"https://static.wikia.nocookie.net/bindingofisaacre_gamepedia/images/9/97/Collectible_Little_Horn_icon.png/revision/latest/scale-to-width-down/20?cb=20210822020536\" /></a></span><a href=\"/wiki/Little_Horn_(Item)\" title=\"Little Horn (Item)\">Little Horn</a></span>, <span class=\"tooltip\" data-tooltip=\"i/tooltip&#124;Euthanasia&#124;8\"><span class=\"inline-icon\" typeof=\"mw:File\"><a href=\"/wiki/Euthanasia\" title=\"Euthanasia\"><img alt=\"Collectible Euthanasia icon\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"20\" height=\"20\" class=\"mw-file-element lazyload\" data-image-name=\"Collectible Euthanasia icon.png\" data-image-key=\"Collectible_Euthanasia_icon.png\" data-relevant=\"0\" data-src=\"https://static.wikia.nocookie.net/bindingofisaacre_gamepedia/images/c/ca/Collectible_Euthanasia_icon.png/revision/latest/scale-to-width-down/20?cb=20210822015723\" /></a></span><a href=\"/wiki/Euthanasia\" title=\"Euthanasia\">Euthanasia</a></span>, or <span class=\"tooltip\" data-tooltip=\"i/tooltip&#124;Suplex%21&#124;8\"><span class=\"inline-icon\" typeof=\"mw:File\"><a href=\"/wiki/Suplex!\" title=\"Suplex!\"><img alt=\"Collectible Suplex! icon\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"20\" height=\"20\" class=\"mw-file-element lazyload\" data-image-name=\"Collectible Suplex! icon.png\" data-image-key=\"Collectible_Suplex%21_icon.png\" data-relevant=\"0\" data-src=\"https://static.wikia.nocookie.net/bindingofisaacre_gamepedia/images/7/76/Collectible_Suplex%21_icon.png/revision/latest/scale-to-width-down/20?cb=20210822150943\" /></a></span><a href=\"/wiki/Suplex!\" title=\"Suplex!\">Suplex!</a></span> as they go through shields.</li></ul>\n<div style=\"clear:both\"></div>\n<h2><span class=\"mw-headline\" id=\"Variations\">Variations</span></h2>\n<h3><span class=\"mw-headline\" id=\"Fanatic\">Fanatic</span></h3><p class=\"mw-empty-elt\">\n\n</p><aside role=\"region\" class=\"portable-infobox pi-background pi-border-color pi-theme-wikia pi-layout-stacked\">\n<h2 class=\"pi-item pi-item-spacing pi-title pi-secondary-background\" data-source=\"name\"><div class=\"infobox2-slideshow dlc-slideshow\"><div class=\"infobox2-slide\"><span style=\"white-space:nowrap\"><span typeof=\"mw:File\"><span><img alt=\"F\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"22\" height=\"27\" class=\"mw-file-element lazyload\" data-image-name=\"Font TeamMeat F.png\" data-image-key=\"Font_TeamMeat_F