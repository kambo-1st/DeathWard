DEATHWARD_MECHANICS 1
# Invulnerable stationary actors, with independent completion and navigation.
# id attack clear interval windup damage speed spread range beam-radius beam-duration turn-rate initial-angle remove-on-cleared-reentry
# Timings/dimensions/damage are explicit DeathWard conversions, not extracted native AI constants.
statue 42.0.0 aimed combat 2.8 .3 10 8 0 32 .25 .08 0 0 0
statue 42.1.0 lob combat 3.5 .35 10 8 0 32 .25 .08 0 0 0
statue_lob 42.1.0 1.1 12 2.5 20
statue 42.2.0 triple combat 3 .3 10 8 .22 32 .25 .08 0 0 0
# Negative Y rotation is clockwise viewed from above (+X right, +Z down).
statue 201.0.0 rotating_beam combat .12 0 10 8 0 28 .12 .07 -.7 0 1
statue 202.0.0 fixed plates .25 0 10 8 0 32 .25 .08 0 0 0
# Subtype .1 uses the source's alternate animation. Its initial diagonal phase
# is a declared local interpretation; exact native startup is still unverified.
statue 202.10.0 cross combat .6 0 10 8 0 32 .25 .08 0 0 0
statue 202.10.1 cross combat .6 0 10 8 0 32 .25 .08 0 .7853981634 0
# Installed XML labels variant 11 always on. Plate precedence is unverified;
# these two debug controllers remain outside ordinary pools pending trap routing.
statue 202.11.0 cross never .6 0 10 8 0 32 .25 .08 0 0 0
statue 202.11.1 cross never .6 0 10 8 0 32 .25 .08 0 .7853981634 0
statue 203.0.0 beam plates 2 .45 10 8 0 32 .24 .65 0 0 0

# Maws never emit shots; the generic shot columns are unused. Force is planar
# with linear range falloff. Normal is continuous; Broken alternates 4s/4s.
# id player-speed projectile-acceleration projectile-speed-limit vertical-range active-seconds inactive-seconds
statue 235.0.0 attraction plates 1 0 1 1 0 24 .25 .08 0 0 0
statue_attraction 235.0.0 2 12 40 4 0 0
statue 236.0.0 attraction plates 1 0 1 1 0 24 .25 .08 0 0 0
statue_attraction 236.0.0 4 24 40 4 4 4

# Quake uses the source three-second landing interval and animation direction.
# Local dimensions/speeds: axis (left/up/right/down), hop-height, hop-seconds,
# wave-radius, visible-trail-seconds. Generic windup/beam columns are unused.
statue 804.0.0 quake plates 3 0 10 10 0 32 .25 .08 0 0 0
statue_quake 804.0.0 0 1 .45 .5 .5
statue 804.0.1 quake plates 3 0 10 10 0 32 .25 .08 0 0 0
statue_quake 804.0.1 1 1 .45 .5 .5
statue 804.0.2 quake plates 3 0 10 10 0 32 .25 .08 0 0 0
statue_quake 804.0.2 2 1 .45 .5 .5
statue 804.0.3 quake plates 3 0 10 10 0 32 .25 .08 0 0 0
statue_quake 804.0.3 3 1 .45 .5 .5

# One additional stationary hazard in a seeded subset of combat rooms. A legal
# footprint and all entrance/objective routes are required; never replace a foe.
statue_rooms 0 0
statue_rooms 1 2500
statue_rooms 2 3000
statue_rooms 3 3500
statue_pool 1 3 any 42.0.0 4
statue_pool 1 3 any 42.1.0 1
statue_pool 1 3 any 42.2.0 2
statue_pool 3 3 any 201.0.0 1
statue_pool 1 3 any 202.0.0 2
statue_pool 1 3 any 202.10.0 1
statue_pool 1 3 any 202.10.1 1
statue_pool 2 3 any 203.0.0 1
statue_pool 1 3 any 235.0.0 1
statue_pool 1 3 any 236.0.0 1
statue_pool 1 1 any 804.0.0 1
statue_pool 1 1 any 804.0.1 1
statue_pool 1 1 any 804.0.2 1
statue_pool 1 1 any 804.0.3 1

# Bomb Grimace is dedicated encounter support, never an ordinary hazard-pool draw.
# Actual supplied pickup 5.41.0 becomes armed bomb 4.13.0 when taken.
statue 809.0.0 supply never 1 0 1 1 0 24 .25 .08 0 0 0
# id replenish fuse blast-radius damage self-damage throw-range flight-time pickup-radius death-drops
