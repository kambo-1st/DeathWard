DEATHWARD_MECHANICS 1
# Stable IDs: package:kind:number. Native hooks execute through the bounded event queue.
item "dw:collectible:0" "Ricochet Coin" "COMMON" "Bullets bounce three times per copy. Body piercing survives a bank shot."
end

item "dw:collectible:1" "Split Lead" "STRANGE" "Hits split into two smaller shots. Fragments share the remaining lifetime and chain budget."
hook split per_copy
end

item "dw:collectible:2" "Judas Bullet" "CURSED" "Every sixth primary shot gains six pierces per copy. Lose 20% of red capacity per copy, rounded down to full containers (at least one)."
pickup_health 0.8 2
end

item "dw:collectible:3" "Powder of Jericho" "STRANGE" "Kills explode; explosion kills can explode again. Free blasts cannot open hard cover."
hook powder per_copy
end

item "dw:collectible:4" "Hangman's Coin" "STRANGE" "Repeat the killing projectile's original specification. Blast damage never increases ghost damage."
hook ghost per_copy
end

item "dw:collectible:5" "Scatter Cylinder" "STRANGE" "A short fan of weak pellets. Rail makes three heavier spikes. Copies add pellets, up to nine."
end

item "dw:collectible:6" "Rail Spike" "STRANGE" "Heavy, slower piercing shots with a slower cadence. Copies add weight and pierces, up to five copies."
end

item "dw:collectible:7" "Lodestone Sight" "STRANGE" "Slower shots bend toward visible enemies. Each fragment seeks independently. Copies improve turning, up to four."
end

item "dw:collectible:8" "Return Spring" "STRANGE" "Short shots return to you. One body per leg; piercing adds targets. Outbound bounces only. Copies extend reach, up to four."
end

item "dw:collectible:9" "Blasting Cap" "DANGEROUS" "Lower bullet damage; the first body hit explodes once and can hurt you. Copies strengthen the blast and risk, up to four."
hook cap once
end

item "dw:collectible:10" "Fuse Braid" "DANGEROUS" "Smaller dynamite blast leaves two weaker delayed charges. They can strike cover again. Copies add power and fuse time, up to four."
end

item "isaac:collectible:433" "My Shadow" "STRANGE" "A trailing shadow spawns allied Chargers when enemies touch it. Up to sixteen allies; they last for this room."
end

# Enemy-interaction dependency only. No natural pool until its other fly effects
# are implemented; existing loadouts and reward distributions remain unchanged.
item "isaac:collectible:9" "Skatole" "STRANGE" "Pooters and Super Pooters stop shooting."
end

# H17 health dependency. Explicit grants/inspection only; natural item-pool
# parity is unselected and other revival items remain unaccepted.
item "isaac:collectible:11" "1up!" "STRANGE" "One extra life. Return to a safe room with filled red containers, or half a soul heart without red containers."
end

# D11a: bounded first-floor treasure pedestal; not added to legacy reward pools.
item "isaac:collectible:1" "The Sad Onion" "TEARS UP" "Faster firing through the ordinary source Tears curve. Copies stack; Shot Speed and Range stay independent."
end

# D12c: bounded shop collectible dependency, outside legacy pools.
item "isaac:collectible:64" "Steam Sale" "SHOP DISCOUNT" "Reduces ordinary source-shop prices. Copies stack; remaining stock updates immediately."
end

# D12f: ordinary pickup factory dependency; no special-bomb actors enabled.
item "isaac:collectible:250" "BOGO Bombs" "DOUBLE DYNAMITE" "New ordinary single-dynamite pickups become doubles. Existing pickups keep their quantity. Extra copies do not multiply again."
end

# D11b: bounded treasure dependency; ordinary damage curve and derived tear size.
item "isaac:collectible:4" "Cricket's Head" "DAMAGE UP" "Raises damage and bullet size. Copies add damage; the multiplier applies once. Firing rate, shot speed and range stay independent."
end

# PW-F01: ordinary shooting familiar; restricted treasure offering.
item "isaac:collectible:8" "Brother Bobby" "FAMILIAR" "A small companion follows and fires with you. Its damage and firing rhythm are independent of your weapon."
category familiar
end

# PW-A01: one ordinary active slot and restricted treasure offering.
item "isaac:collectible:45" "Yum Heart" "ACTIVE" "Restores one red heart. Uses four charges even at full health; combat room clears recharge it."
category active
end

# PW-T01: separate held trinket; bounded ordinary clear-award pool.
item "isaac:trinket:39" "Cancer" "TRINKET" "Adds one tear per second while held, beyond the ordinary Tears cap. Drop it to remove the effect."
end

# PW-T02: second held trinket; independent Shot Speed contribution.
item "isaac:trinket:27" "Whip Worm" "TRINKET" "Adds 0.5 Shot Speed while held. Firing rate and maximum range stay unchanged. Swap or drop it to remove the effect."
end
